rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só lê e grava os próprios projetos, depois de entrar com o Google.
    match /usuarios/{uid}/projetos/{projeto} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Projetos antigos do código de sincronização: só leitura, para a migração na primeira entrada.
    match /tempo-sincronizacao/{codigo}/projetos/{projeto} {
      allow read: if request.auth != null && codigo.size() >= 6;
    }
  }
}

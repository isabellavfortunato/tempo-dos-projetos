rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só lê e grava os próprios projetos, depois de entrar com o Google.
    match /usuarios/{uid}/projetos/{projeto} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Aparelhos que recebem os avisos da tela bloqueada.
    match /usuarios/{uid}/aparelhos/{aparelho} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Hora prevista para o fim de cada timer em andamento.
    match /avisos/{aviso} {
      allow read, delete: if request.auth != null && aviso.matches(request.auth.uid + '_.*');
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid
                            && aviso.matches(request.auth.uid + '_.*');
    }
    // Projetos antigos do código de sincronização: só leitura, para a migração na primeira entrada.
    match /tempo-sincronizacao/{codigo}/projetos/{projeto} {
      allow read: if request.auth != null && codigo.size() >= 6;
    }
  }
}
